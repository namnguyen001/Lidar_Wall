{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LidarWallConfig",
  "type": "object",
  "required": ["version", "wall", "lidars", "blob", "zones", "output"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "wall": {
      "type": "object", "additionalProperties": false,
      "required": ["widthPx", "heightPx", "widthMm", "heightMm"],
      "properties": {
        "name": { "type": "string" },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 },
        "widthMm": { "type": "number", "exclusiveMinimum": 0 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "lidars": { "type": "array", "items": { "$ref": "#/$defs/lidar" } },
    "blob": { "$ref": "#/$defs/blob" },
    "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
    "output": { "$ref": "#/$defs/output" },
    "ui": { "type": "object" }
  },
  "$defs": {
    "point2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "quad": { "type": "array", "items": { "$ref": "#/$defs/point2" }, "minItems": 4, "maxItems": 4 },
    "connection": {
      "oneOf": [
        { "type": "object", "required": ["kind", "port", "baud"], "additionalProperties": false,
          "properties": { "kind": { "const": "serial" }, "port": { "type": "string" }, "baud": { "type": "integer" } } },
        { "type": "object", "required": ["kind", "host", "port"], "additionalProperties": false,
          "properties": { "kind": { "const": "tcp" }, "host": { "type": "string" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 } } },
        { "type": "object", "required": ["kind"], "additionalProperties": false,
          "properties": { "kind": { "const": "simulator" }, "seed": { "type": "integer" }, "hands": { "type": "integer", "minimum": 0, "maximum": 3 } } }
      ]
    },
    "lidar": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "model", "enabled", "connection", "transform", "scanArea"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "name": { "type": "string" },
        "model": { "enum": ["ydlidar-tea", "ydlidar-g4", "simulator"] },
        "enabled": { "type": "boolean" },
        "connection": { "$ref": "#/$defs/connection" },
        "params": { "type": "object" },
        "transform": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "flipX": { "type": "boolean" }, "flipY": { "type": "boolean" },
            "rotationDeg": { "type": "number" }, "offsetMm": { "$ref": "#/$defs/point2" }
          }
        },
        "scanArea": {
          "type": "object", "additionalProperties": false, "required": ["mode", "quadMm"],
          "properties": { "mode": { "enum": ["free", "rect"] }, "quadMm": { "$ref": "#/$defs/quad" } }
        },
        "coverageUv": { "$ref": "#/$defs/quad" },
        "background": { "type": "object" },
        "calibration": { "type": "object" },
        "overrides": { "type": "object" }
      }
    },
    "blob": {
      "type": "object",
      "properties": {
        "clusterGapMm": { "type": "number", "minimum": 5 },
        "minPoints": { "type": "integer", "minimum": 1 },
        "minSizeMm": { "type": "number", "minimum": 0 },
        "maxSizeMm": { "type": "number", "minimum": 1 },
        "confirmFrames": { "type": "integer", "minimum": 1 },
        "lostFrames": { "type": "integer", "minimum": 0 },
        "maxMatchDistUv": { "type": "number", "minimum": 0.001, "maximum": 1 },
        "smoothing": { "type": "number", "minimum": 0, "maximum": 1 },
        "mergeRadiusMm": { "type": "number", "minimum": 0 }
      }
    },
    "zone": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "enabled", "shape", "trigger"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "enabled": { "type": "boolean" },
        "layer": { "type": "integer" }, "color": { "type": "string" },
        "shape": {
          "oneOf": [
            { "type": "object", "required": ["type", "x", "y", "w", "h"],
              "properties": { "type": { "const": "rect" }, "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" } } },
            { "type": "object", "required": ["type", "cx", "cy", "r"],
              "properties": { "type": { "const": "circle" }, "cx": { "type": "number" }, "cy": { "type": "number" }, "r": { "type": "number" } } },
            { "type": "object", "required": ["type", "points"],
              "properties": { "type": { "const": "polygon" }, "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point2" } } } }
          ]
        },
        "trigger": { "enum": ["enter", "exit", "hold", "touch"] },
        "dwellMs": { "type": "integer", "minimum": 0 }, "repeatMs": { "type": "integer", "minimum": 0 },
        "minBlobs": { "type": "integer", "minimum": 1 }, "cooldownMs": { "type": "integer", "minimum": 0 },
        "hysteresisUv": { "type": "number", "minimum": 0 }, "exclusiveGroup": { "type": ["string", "null"] },
        "output": { "type": "object" }
      }
    },
    "output": { "type": "object" }
  }
}
